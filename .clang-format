---
# Hypercom coding norm.
# Mechanically encodes rules L4, G7 and G8.
# Rule L6 (no blank line inside a function body) is NOT expressible
# here: clang-format can't tell the inside of a function apart from
# the rest of the file. It's checked at review time.
Language: Cpp
BasedOnStyle: LLVM
Standard: c++20

ColumnLimit: 80
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4

# --- Rule L4: brace placement -----------------------------------------------
# Function definition -> opening brace alone on its own line.
# Everything else     -> opening brace at the end of the line.
# else / catch / do's while -> on the closing brace's line.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterClass: false
  AfterStruct: false
  AfterUnion: false
  AfterEnum: false
  AfterNamespace: false
  AfterExternBlock: false
  AfterControlStatement: Never
  AfterCaseLabel: false
  BeforeElse: false
  BeforeCatch: false
  BeforeWhile: false
  BeforeLambdaBody: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

# --- Rules G7 / G8 / L6: spaces and blank lines ------------------------------
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: false
EmptyLineBeforeAccessModifier: LogicalBlock

# --- Rule F4: nothing should hide a function's real length ------------------
AllowShortFunctionsOnASingleLine: None
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortLambdasOnASingleLine: All

# --- Pointers and references -------------------------------------------------
DerivePointerAlignment: false
PointerAlignment: Right
ReferenceAlignment: Right

# --- Misc ----------------------------------------------------------------
IndentCaseLabels: true
NamespaceIndentation: None
FixNamespaceComments: true
AlwaysBreakTemplateDeclarations: Yes
BreakConstructorInitializers: BeforeColon
PackConstructorInitializers: NextLine
Cpp11BracedListStyle: true
SpaceAfterCStyleCast: true
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
