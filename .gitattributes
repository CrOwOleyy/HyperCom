# Rule G6: UNIX line endings (\n) across the whole repo, no exceptions.
# This directive takes priority over core.autocrlf, even on Windows.
* text=auto eol=lf

# Binary files: no line ending conversion.
*.png   binary
*.jpg   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.zip   binary
*.gz    binary
*.db    binary
